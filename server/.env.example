# Server
PORT=4000
NODE_ENV=development
LOG_LEVEL=info
CLIENT_URL=http://localhost:5173

# Database (matches docker-compose.yml; host port 5433)
DATABASE_URL=postgresql://aicompliance:aicompliance@localhost:5433/aicompliance?schema=public

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=aic_session

# Email (Nodemailer)
# Leave SMTP_HOST blank in development to auto-create an Ethereal test account.
# A preview URL for every sent email is printed to the server logs.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="JurisAI <no-reply@aicompliance.local>"

# Screenshot-feedback plugin (comma-separated recipient list)
FEEDBACK_RECIPIENTS=team@example.com

# Reminders
REMINDER_CRON=0 7 * * *
REMINDER_LEAD_DAYS=30

# Scheduled jobs
SNAPSHOT_CRON=0 1 * * *
MONTHLY_REPORT_CRON=0 8 1 * *

# Optional: Claude API for the Law Explorer "describe your AI use" feature.
# Leave blank to use the built-in keyword matcher instead.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
