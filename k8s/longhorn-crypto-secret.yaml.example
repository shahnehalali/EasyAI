# Longhorn volume-encryption key (LUKS passphrase) for the `longhorn-encrypted`
# StorageClass. Create OUT OF BAND — do NOT commit the real key.
#
#   cp k8s/longhorn-crypto-secret.yaml.example k8s/longhorn-crypto-secret.yaml
#   # set a strong CRYPTO_KEY_VALUE, then:
#   kubectl apply -f k8s/longhorn-crypto-secret.yaml
#
# ⚠️  BACK UP CRYPTO_KEY_VALUE somewhere safe (password manager / Vaultwarden),
#     separate from the DB backups. If it is lost, the encrypted volumes cannot
#     be unlocked and ALL data is permanently unrecoverable.
#
# Generate a strong key:  openssl rand -base64 48
apiVersion: v1
kind: Secret
metadata:
  name: longhorn-crypto
  namespace: longhorn-system
type: Opaque
stringData:
  CRYPTO_KEY_VALUE: "CHANGE_ME_STRONG_PASSPHRASE"
  CRYPTO_KEY_PROVIDER: "secret"
  CRYPTO_KEY_CIPHER: "aes-xts-plain64"
  CRYPTO_KEY_HASH: "sha256"
  CRYPTO_KEY_SIZE: "256"
  CRYPTO_PBKDF: "argon2i"
