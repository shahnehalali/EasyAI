# TEMPLATE ONLY — note the ".example" extension: ArgoCD ignores it (it is NOT a
# .yaml/.yml/.json file), so it is never applied to the cluster. Copy it, fill in
# real values, and apply MANUALLY:
#   cp k8s/jurisai-app-secrets.yaml.example k8s/jurisai-app-secrets.yaml
#   # edit real values
#   kubectl apply -f k8s/jurisai-app-secrets.yaml      # gitignored — never commit
#
# The Deployments reference this secret by name (jurisai-app-secrets). Keeping it
# out of the ArgoCD-synced manifest is deliberate: ArgoCD must not manage/overwrite
# real credentials.
apiVersion: v1
kind: Secret
metadata:
  name: jurisai-app-secrets
  namespace: jurisai
type: Opaque
stringData:
  # --- Postgres (must match DATABASE_URL below) ---
  POSTGRES_USER: jurisai
  POSTGRES_PASSWORD: CHANGE_ME_STRONG_DB_PASSWORD
  POSTGRES_DB: jurisai

  # --- App / server ---
  NODE_ENV: production
  DATABASE_URL: postgresql://jurisai:CHANGE_ME_STRONG_DB_PASSWORD@jurisai-postgres:5432/jurisai?schema=public
  JWT_SECRET: CHANGE_ME_LONG_RANDOM_64_CHARS
  JWT_EXPIRES_IN: 7d
  COOKIE_NAME: jurisai_session
  CLIENT_URL: https://jurisai.rit.services
  # Field-encryption master key (base64 of 32 bytes). MUST be stable + backed up.
  # Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
  DATA_ENC_KEY: CHANGE_ME_BASE64_32_BYTES

  # --- Email (Resend). Primary transport. Use a FROM on a domain verified in Resend. ---
  RESEND_API_KEY: "re_your_resend_api_key"
  EMAIL_FROM: JurisAI <no-reply@rit.services>
  # Optional SMTP fallback (used only if RESEND_API_KEY is blank).
  SMTP_HOST: ""
  SMTP_PORT: "587"
  SMTP_SECURE: "false"
  SMTP_USER: ""
  SMTP_PASS: ""

  # --- Screenshot-feedback plugin recipients ---
  FEEDBACK_RECIPIENTS: rit.services.backend@gmail.com
  # Spirex ticketing API key (rjk_...). Org/Project IDs are non-secret and set as
  # plain env in jurisai-k8s.yaml. Leave blank to disable ticket creation.
  SPIREX_API_KEY: ""

  # Set to "true" only if you intentionally want the demo/admin seed accounts.
  SEED_DEMO: "false"
